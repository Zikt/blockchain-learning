{
  "name": "blockchain-learning",
  // Same pinned image as `make docker-build` and CI (../Dockerfile, versions in ../toolchain.env).
  "build": { "dockerfile": "../Dockerfile", "context": ".." },
  // Node for the frontends (week 7 dApp, the demo site). Not needed for tests or the demo.
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "lts" }
  },
  "remoteUser": "dev",
  "postCreateCommand": "git submodule update --init --recursive",
  "forwardPorts": [8545, 8000],
  "customizations": {
    "vscode": { "extensions": ["NomicFoundation.hardhat-solidity", "ms-python.python"] }
  },
  "postAttachCommand": "echo 'Run the demo: cd trust-stack && make demo'"
}

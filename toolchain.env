# Tool versions for this repo, in one place.
# Read by the Dockerfile (and so Codespaces) and by CI. When you upgrade,
# change them here, keep solc_version in trust-stack/foundry.toml the same,
# rebuild (make docker-build) and check make test and make demo still pass.
FOUNDRY_VERSION=v1.5.1
SOLC_VERSION=0.8.28
